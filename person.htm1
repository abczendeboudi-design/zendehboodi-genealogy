    /*
     * اگر نام پیدا نشد
     */

    if (!personName || !familyData[personName]) {

        document.querySelector(".hero").style.display = "none";
        document.querySelector(".profile").style.display = "none";
        document.querySelector(".tree-box").style.display = "none";

        document.getElementById("notFound").style.display = "block";

    } else {

        const person = familyData[personName];


        /* عنوان */

        document.getElementById("pageTitle").textContent =
            "🌳 شجره‌نامه " + personName;

        document.getElementById("personName").textContent =
            personName;

        document.getElementById("treeTitle").textContent =
            "خانواده " + personName;


        /* اطلاعات */

        document.getElementById("father").textContent =
            person.father || "ثبت نشده";

        document.getElementById("mother").textContent =
            person.mother || "ثبت نشده";

        document.getElementById("spouse").textContent =
            person.spouse || "ثبت نشده";

        document.getElementById("childrenInfo").textContent =
            person.children.length
                ? person.children.map(x => x.name).join("، ")
                : "فرزندی ثبت نشده";


        /* والد */

        document.getElementById("ancestor").textContent =
            personName;


        /* فرزندان */

        const grid =
            document.getElementById("childrenGrid");


        person.children.forEach(child => {

            const card =
                document.createElement("a");

            card.className = "child-card";

            card.href =
                "person.html?name=" +
                encodeURIComponent(child.name);


            let html = "";

            html += `
                <div class="child-name">
                    ${child.name}
                </div>
            `;

            html += `
                <div class="child-relation">
                    فرزند ${personName}
                </div>
            `;


            if (child.spouse) {

                html += `
                    <div class="child-spouse">
                        همسر: ${child.spouse}
                    </div>
                `;

            }


            if (child.children.length) {

                html += `
                    <div class="grandchildren">

                        <div class="grandchildren-title">
                            فرزندان:
                        </div>

                        <div class="grandchildren-list">

                            ${child.children.map(
                                name =>
                                `<span class="grandchild">${name}</span>`
                            ).join("")}

                        </div>

                    </div>
                `;

            }


            card.innerHTML = html;

            grid.appendChild(card);

        });

    }

</script>


</body>
</html>
