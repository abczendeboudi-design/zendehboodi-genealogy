/*
====================================================
تابع ساخت لینک
====================================================
*/

function personLink(name) {

  return "person.html?name=" + encodeURIComponent(name);

}


/*
====================================================
گرفتن نام از آدرس
====================================================
*/

const params = new URLSearchParams(window.location.search);

const requestedName = params.get("name");


/*
====================================================
نمایش صفحه
====================================================
*/

const app = document.getElementById("app");


if (!requestedName) {

  showNotFound("نام شخص مشخص نشده است.");

} else {

  showPerson(requestedName);

}


/*
====================================================
نمایش شخص
====================================================
*/

function showPerson(name) {

  const data = familyData[name];


  /*
    اگر اطلاعات این شخص در داده‌ها نباشد،
    صفحه سفید نمی‌شود.
  */

  if (!data) {

    showNotFound(
      "برای «" + name + "» هنوز صفحه اختصاصی ثبت نشده است."
    );

    return;
  }


  let html = "";


  /*
    پروفایل
  */

  html += `
    <div class="profile">

      <div class="photo">
        👤
      </div>

      <h2>${escapeHTML(name)}</h2>

      <div class="subtitle">
        اطلاعات شجره‌نامه خاندان
      </div>

      <div class="details">
  `;


  if (data.father) {

    html += `
      <div class="detail">
        <span class="label">پدر:</span>
        ${escapeHTML(data.father)}
      </div>
    `;

  }


  if (data.mother) {

    html += `
      <div class="detail">
        <span class="label">مادر:</span>
        ${escapeHTML(data.mother)}
      </div>
    `;

  }


  if (data.spouse) {

    html += `
      <div class="detail">
        <span class="label">همسر:</span>
        ${escapeHTML(data.spouse)}
      </div>
    `;

  }


  if (data.spouses && data.spouses.length) {

    html += `
      <div class="detail">
        <span class="label">همسر:</span>
        ${data.spouses.map(escapeHTML).join(" ، ")}
      </div>
    `;

  }


  html += `
      <div class="detail">
        <span class="label">شغل:</span>
        اطلاعاتی ثبت نشده
      </div>

      <div class="detail">
        <span class="label">تحصیلات:</span>
        اطلاعاتی ثبت نشده
      </div>

    </div>

  </div>
  `;


  /*
    همسر
  */

  if (data.spouse) {

    html += `
      <div class="section">

        <h3>💍 همسر</h3>

        <div class="spouse-box">

          <div class="spouse-title">
            همسر
          </div>

          <div>
            ${escapeHTML(data.spouse)}
          </div>

        </div>

      </div>
    `;

  }


  /*
    چند همسر
  */

  if (data.spouses && data.spouses.length) {

    html += `
      <div class="section">

        <h3>💍 همسران</h3>
    `;

    data.spouses.forEach(function(spouse) {

      html += `
        <div class="spouse-box">

          <div class="spouse-title">
            همسر
          </div>

          <div>
            ${escapeHTML(spouse)}
          </div>

        </div>
      `;

    });

    html += `
      </div>
    `;

  }


  /*
    فرزندان
  */

  html += `
    <div class="section">

      <h3>👨‍👩‍👧‍👦 فرزندان</h3>
  `;


  if (data.children && data.children.length) {

    data.children.forEach(function(child) {

      const hasPage = familyData[child] !== undefined;

      html += `
        <a class="person-card" href="${personLink(child)}">

          <strong>
            ${escapeHTML(child)}
          </strong>

          <small>
            ${hasPage
              ? "مشاهده اطلاعات و ادامه شجره‌نامه ←"
              : "مشاهده صفحه شخص ←"
            }
          </small>

        </a>
      `;

    });

  } else {

    html += `
      <div class="empty">
        برای این شخص فرزندی در اطلاعات فعلی ثبت نشده است.
      </div>
    `;

  }


  html += `
    </div>
  `;


  app.innerHTML = html;

}


/*
====================================================
صفحه پیدا نشدن
====================================================
*/

function showNotFound(message) {

  app.innerHTML = `

    <div class="not-found">

      <div class="icon">
        🌳
      </div>

