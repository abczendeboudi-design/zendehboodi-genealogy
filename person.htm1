<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>شجره‌نامه شخص</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f0e6;
            color: #183b2b;
            font-family: Tahoma, Arial, sans-serif;
            line-height: 1.8;
        }

        a {
            text-decoration: none;
        }

        /* نوار بالا */

        .topbar {
            background: #173f2c;
            color: white;
            padding: 13px 5%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;

            position: sticky;
            top: 0;
            z-index: 100;

            box-shadow: 0 3px 15px rgba(0,0,0,.15);
        }

        .topbar strong {
            font-size: 14px;
        }

        .back {
            color: white;
            background: rgba(255,255,255,.1);
            padding: 5px 12px;
            border-radius: 10px;
            font-size: 13px;
        }

        /* صفحه */

        .container {
            width: 94%;
            max-width: 1100px;
            margin: auto;
        }

        .page {
            padding: 35px 0 70px;
        }

        /* عنوان */

        .hero {
            background: #fffdf8;
            border: 1px solid #ded5c4;
            border-radius: 23px;
            padding: 25px;
            text-align: center;

            box-shadow: 0 10px 30px rgba(24,59,43,.08);

            margin-bottom: 30px;
        }

        .tag {
            display: inline-block;
            background: #e7d2a6;
            color: #173f2c;
            padding: 4px 13px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: bold;
        }

        .hero h1 {
            margin: 10px 0 5px;
            font-size: clamp(25px, 5vw, 38px);
        }

        .hero p {
            margin: 0;
            color: #68756d;
            font-size: 14px;
        }

        /* اطلاعات شخص */

        .profile {
            display: grid;
            grid-template-columns: 190px 1fr;
            gap: 25px;

            background: #fffdf8;
            border: 1px solid #ded5c4;
            border-radius: 22px;

            padding: 22px;

            box-shadow: 0 8px 25px rgba(24,59,43,.07);

            margin-bottom: 30px;
        }

        .photo {
            width: 190px;
            height: 190px;

            border-radius: 18px;

            background: #eee7d9;

            display: flex;
            align-items: center;
            justify-content: center;

            color: #8a918b;
            font-size: 13px;

            border: 1px solid #ddd2bd;

            overflow: hidden;
        }

        .photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .info h2 {
            margin: 0 0 12px;
            font-size: 24px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .info-item {
            background: #f4efe5;
            border-radius: 11px;
            padding: 9px 12px;
            font-size: 13px;
        }

        .info-item strong {
            color: #173f2c;
        }

        /* شجره */

        .tree-box {
            background: #fffdf8;
            border: 1px solid #ded5c4;
            border-radius: 22px;

            padding: 25px;

            box-shadow: 0 8px 25px rgba(24,59,43,.07);
        }

        .tree-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .tree-title h2 {
            margin: 7px 0;
            font-size: 23px;
        }

        .tree-title p {
            margin: 0;
            color: #68756d;
            font-size: 13px;
        }

        /* کارت والد */

        .ancestor {
            text-align: center;
            margin-bottom: 25px;
        }

        .ancestor-card {
            display: inline-block;

            background: #e7d2a6;
            color: #173f2c;

            padding: 12px 25px;

            border-radius: 15px;

            font-weight: bold;
        }

        /* خط عمودی */

        .vertical-line {
            width: 2px;
            height: 25px;
            background: #b99a68;
            margin: auto;
        }

        /* فرزندان */

        .children-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(190px, 1fr));

            gap: 15px;
        }

        .child-card {
            background: #f7f3ea;

            border: 1px solid #ded5c4;

            border-radius: 16px;

            padding: 16px;

            color: #183b2b;

            transition: .2s;
        }

        .child-card:hover {
            transform: translateY(-3px);
            border-color: #b99a68;
            box-shadow: 0 8px 20px rgba(24,59,43,.1);
        }

        .child-name {
            font-size: 18px;
            font-weight: bold;
        }

        .child-relation {
            font-size: 12px;
            color: #737d76;
            margin-top: 3px;
        }

        .child-spouse {
            border-top: 1px dashed #d5cbb9;
            margin-top: 9px;
            padding-top: 8px;

            font-size: 12px;
            color: #66736b;
        }

        .grandchildren {
            margin-top: 10px;
        }

        .grandchildren-title {
            font-size: 11px;
            color: #777;
            margin-bottom: 5px;
        }

        .grandchildren-list {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .grandchild {
            background: #e8eee4;
            color: #315d46;

            border-radius: 7px;

            padding: 3px 7px;

            font-size: 11px;
        }

        /* دکمه برگشت */

        .actions {
            text-align: center;
            margin-top: 30px;
        }

        .button {
            display: inline-block;

            background: #216547;
            color: white;

            padding: 11px 20px;

            border-radius: 12px;

            font-size: 14px;
            font-weight: bold;

            margin: 5px;
        }

        .button.secondary {
            background: #e7d2a6;
            color: #173f2c;
        }

        /* خطا */

        .not-found {
            display: none;

            background: #fffdf8;
            border: 1px solid #ded5c4;
            border-radius: 20px;

            padding: 35px;

            text-align: center;
        }

        /* موبایل */

        @media (max-width: 700px) {

            .topbar {
                flex-direction: column;
                text-align: center;
            }

            .profile {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .photo {
                margin: auto;
            }

            .info-grid {
                grid-template-columns: 1fr;
                text-align: right;
            }

            .tree-box {
                padding: 15px;
            }

            .children-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>
</head>


<body>


<header class="topbar">

    <a href="members.html" class="back">
        ← بازگشت به اعضای خانواده
    </a>

    <strong>
        شجره‌نامه خاندان غلامحسین قاسم زائر غلامحسین
    </strong>

</header>


<main class="container page">


    <!-- عنوان -->

    <section class="hero">

        <span class="tag">
            شجره‌نامه شخص
        </span>

        <h1 id="pageTitle">
            در حال بارگذاری...
        </h1>

        <p id="pageSubtitle">
            خاندان غلامحسین قاسم زائر غلامحسین
        </p>

    </section>


    <!-- اطلاعات -->

    <section class="profile">

        <div class="photo">

            <!--
                وقتی عکس هر شخص را داشته باشیم
                این قسمت را با عکس پر می‌کنیم.
            -->

            <span>
                عکس موجود نیست
            </span>

        </div>


        <div class="info">

            <h2 id="personName">
                —
            </h2>

            <div class="info-grid">

                <div class="info-item">
                    <strong>پدر:</strong>
                    <span id="father">—</span>
                </div>

                <div class="info-item">
                    <strong>مادر:</strong>
                    <span id="mother">—</span>
                </div>

                <div class="info-item">
                    <strong>همسر:</strong>
                    <span id="spouse">—</span>
                </div>

                <div class="info-item">
                    <strong>فرزندان:</strong>
                    <span id="childrenInfo">—</span>
                </div>

                <div class="info-item">
                    <strong>شغل:</strong>
                    <span>اطلاعات وارد نشده</span>
                </div>

                <div class="info-item">
                    <strong>تحصیلات:</strong>
                    <span>اطلاعات وارد نشده</span>
                </div>

            </div>

        </div>

    </section>


    <!-- شجره -->

    <section class="tree-box">

        <div class="tree-title">

            <span class="tag">
                درخت خانوادگی
            </span>

            <h2 id="treeTitle">
                —
            </h2>

            <p>
                نسل‌های ثبت‌شده در اطلاعات شجره‌نامه
            </p>

        </div>


        <!-- والد -->

        <div class="ancestor">

            <div class="ancestor-card" id="ancestor">
                —
            </div>

            <div class="vertical-line"></div>

        </div>


        <!-- فرزندان -->

        <div class="children-grid" id="childrenGrid">
        </div>


    </section>


    <!-- دکمه‌ها -->

    <div class="actions">

        <a href="members.html" class="button">
            ← بازگشت به فهرست خانواده
        </a>

        <a href="index.html" class="button secondary">
            صفحه اصلی
        </a>

    </div>


    <!-- اگر شخص پیدا نشد -->

    <section class="not-found" id="notFound">

        <h2>
            شخص پیدا نشد
        </h2>

        <p>
            اطلاعات این شخص هنوز در شجره‌نامه دیجیتال ثبت نشده است.
        </p>

        <a href="members.html" class="button">
            بازگشت به اعضای خانواده
        </a>

    </section>


</main>


<footer>

    شجره‌نامه روستای قباکلکی

</footer>


<script>

    /*
     * نام شخص از آدرس صفحه گرفته می‌شود.
     *
     * مثال:
     *
     * person.html?name=قاسم
     *
     */

    const params = new URLSearchParams(window.location.search);

    const personName = params.get("name");


    /*
     * اطلاعات شجره‌نامه
     *
     * فقط اطلاعاتی که در شجره‌نامه داده شده
