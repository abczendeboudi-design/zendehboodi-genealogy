/*
========================================================
تبدیل ID به لینک
========================================================
*/

function personLink(id) {
  return "person.html?id=" + encodeURIComponent(id);
}


/*
========================================================
گرفتن ID از آدرس
========================================================
*/

const params = new URLSearchParams(window.location.search);

const id = params.get("id");


/*
========================================================
نمایش
========================================================
*/

const app = document.getElementById("app");


if (!id) {

  showNotFound("شناسه شخص در آدرس وجود ندارد.");

} else if (!people[id]) {

  showNotFound("این شخص در اطلاعات شجره‌نامه پیدا نشد.");

} else {

  showPerson(id);

}


/*
========================================================
نمایش صفحه شخص
========================================================
*/

function showPerson(id) {

  const person = people[id];

  document.title = person.name + " | شجره‌نامه قباکلکی";


  let html = "";


  /* ===============================
     کارت مشخصات
  =============================== */

  html += `

    <div class="profile">

      <div class="photo">
        👤
      </div>

      <h2>
        ${escapeHTML(person.name)}
      </h2>

      <div class="subtitle">
        اطلاعات شجره‌نامه
      </div>

      <div class="details">
  `;


  if (person.father) {

    html += `
      <div class="detail">
        <span class="label">پدر:</span>
        ${escapeHTML(person.father)}
      </div>
    `;

  }


  if (person.mother) {

    html += `
      <div class="detail">
        <span class="label">مادر:</span>
        ${escapeHTML(person.mother)}
      </div>
    `;

  }


  if (person.spouses && person.spouses.length > 0) {

    html += `
      <div class="detail">
        <span class="label">همسر:</span>
        ${person.spouses.map(escapeHTML).join(" ، ")}
      </div>
    `;

  }


  html += `

      <div class="detail">
        <span class="label">شغل:</span>
        اطلاعاتی ثبت نشده
      </div>

      <div class="detail">
        <span class="label">تحصیلات:</span>
        اطلاعاتی ثبت نشده
      </div>

    </div>

  </div>

  `;


  /* ===============================
     همسران
  =============================== */

  if (person.spouses && person.spouses.length > 0) {

    html += `

      <div class="section">

        <h3>
          💍 همسر
        </h3>
    `;

    person.spouses.forEach(function(spouse) {

      html += `

        <div class="spouse-box">

          <div class="spouse-title">
            همسر
          </div>

          <div>
            ${escapeHTML(spouse)}
          </div>

        </div>

      `;

    });

    html += `

      </div>

    `;

  }


  /* ===============================
     فرزندان
  =============================== */

  html += `

    <div class="section">

      <h3>
        👨‍👩‍👧‍👦 فرزندان
      </h3>

  `;


  if (person.children && person.children.length > 0) {

    person.children.forEach(function(childId) {

      const child = people[childId];

      if (!child) {
        return;
      }

      html += `

        <a
          class="person-card"
          href="${personLink(childId)}"
        >

          <strong>
            ${escapeHTML(child.name)}
          </strong>

          <small>
            مشاهده اطلاعات و ادامه شجره‌نامه ←
          </small>

        </a>

      `;

    });

  } else {

    html += `

      <div class="empty">
        برای این شخص فرزندی در اطلاعات فعلی ثبت نشده است.
      </div>

    `;

  }


  html += `

    </div>

  `;


  app.innerHTML = html;

}


/*
========================================================
صفحه خطا
========================================================
*/

function showNotFound(message) {

  app.innerHTML = `

    <div class="not-found">

      <div class="icon">
        🌳
      </div>

      <h2>
        شخص پیدا نشد
      </h2>

      <p>
        ${escapeHTML(message)}
      </p>

      <a href="members.html">
        ← بازگشت به شجره‌نامه
      </a>

    </div>

  `;

}


/*
========================================================
امنیت متن
========================================================
*/

function escapeHTML(text) {

  return String(text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}

</script>

